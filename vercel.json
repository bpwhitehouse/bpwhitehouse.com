{
  "rewrites": [
    {
      "source": "/discovery-demo",
      "destination": "https://discovery-engine-plum-three.vercel.app/demo"
    },
    {
      "source": "/discovery-demo/:path*",
      "destination": "https://discovery-engine-plum-three.vercel.app/demo/:path*"
    },
    {
      "source": "/_next/:path*",
      "destination": "https://discovery-engine-plum-three.vercel.app/_next/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://discovery-engine-plum-three.vercel.app/api/:path*"
    }
  ]
}